# backend/.env 로 복사해서 사용 (.env는 gitignore - 실제 값 커밋 금지)

# 서버
SERVER_PORT=8080

# MariaDB (3번 커밋에서 사용)
DB_URL=jdbc:mariadb://localhost:3306/hangat
DB_USER=hangat
DB_PASS=change-me
DB_DRIVER=org.mariadb.jdbc.Driver

# 공공데이터포털 서비스 키 - 원본(Decoding) 키를 넣는다 (이중 인코딩 주의)
SERVICE_KEY=your-decoding-key-here
