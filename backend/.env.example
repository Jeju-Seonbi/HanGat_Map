# backend/.env 로 복사해서 사용 (.env는 gitignore - 실제 값 커밋 금지)
# 아래 DB 기본값은 backend/docker-compose.yml 의 MariaDB와 동일 - 도커 쓰면 .env 없이도 부팅됨

# 서버
SERVER_PORT=8080

# MariaDB
DB_URL=jdbc:mariadb://localhost:3306/hangatmap
DB_USER=root
DB_PASS=qwer1234

# 공공데이터포털 서비스 키 - 원본(Decoding) 키를 넣는다 (이중 인코딩 주의)
SERVICE_KEY=your-decoding-key-here
